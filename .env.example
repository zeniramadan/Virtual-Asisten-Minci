# Salin file ini jadi ".env" (di folder yang sama), lalu isi nilainya.
# JANGAN di-commit / dibagikan, isinya rahasia.

# ===== WhatsApp Cloud API (Meta) =====
WA_VERIFY_TOKEN=isi_token_bebas_kamu
WA_ACCESS_TOKEN=isi_access_token_dari_meta
WA_PHONE_NUMBER_ID=isi_phone_number_id
WA_API_VERSION=v26.0

# ===== ngrok (untuk URL publik webhook) =====
NGROK_AUTH_TOKEN=isi_authtoken_dari_dashboard_ngrok

# ===== Gemini (hanya untuk evaluate_rag.py) =====
GEMINI_API_KEY=isi_api_key_dari_ai.google.dev
GEMINI_MODEL=gemini-3.5-flash-lite

# ===== Opsional =====
# LLM_MODEL=minci
# EMBED_MODEL=bge-m3
# FLASK_PORT=8000
